# Durable blog visitor counter (recommended): Upstash Redis REST.
# Create a persistent Redis database at https://console.upstash.com/
# Set these values as Netlify Function environment variables.
# DO NOT commit real tokens. No extra npm dependency is required.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Existing CounterAPI v2 backend (legacy).
# With Upstash variables absent, the site continues using CounterAPI.
# If you have old CounterAPI totals, keep these values temporarily for migration.
COUNTER_API_WORKSPACE=
COUNTER_API_TOKEN=

# One-time migration, optional. Enable only during migration from CounterAPI:
# COUNTER_MIGRATE_FROM_COUNTERAPI=true
# For each missing Redis key: GET the legacy total and SETNX into Redis.
# Existing Redis keys are never overwritten. If CounterAPI returns an error,
# migration stops instead of silently resetting the total.
# Disable this after all existing article counters have been read/migrated.
COUNTER_MIGRATE_FROM_COUNTERAPI=false
