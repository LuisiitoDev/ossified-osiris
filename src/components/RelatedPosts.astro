---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { articleRoute } from '../utils/i18n.mjs';
import { spanishListing } from '../utils/spanishContent.mjs';

interface Props {
  currentId: string;
  tags?: string[];
  locale?: 'en' | 'es';
}

const { currentId, tags = [], locale = 'en' } = Astro.props;
const tagSet = new Set(tags);
const candidates = (await getCollection('blog'))
  .filter((post) => !post.id.startsWith('es/') && post.id !== currentId)
  .map((post) => ({
    post,
    sharedTags: post.data.tags.filter((tag) => tagSet.has(tag)).length,
  }))
  .sort((a, b) =>
    b.sharedTags - a.sharedTags ||
    b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()
  );
const suggestions = candidates.slice(0, 3);
const hasRelated = suggestions.some((item) => item.sharedTags > 0);
---

{suggestions.length > 0 && (
  <aside aria-labelledby="related-articles-heading" class="mt-10">
    <h2 id="related-articles-heading" class="text-2xl font-bold mb-5 text-slate-900 dark:text-slate-50">
      {hasRelated ? (locale === 'es' ? 'Artículos relacionados' : 'Related articles') : (locale === 'es' ? 'Más artículos' : 'More from the blog')}
    </h2>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {suggestions.map(({ post }) => (
        <li class="min-w-0">
          <a href={articleRoute(post.id, locale)} class="glass-card group block h-full rounded-xl p-5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500">
            <h3 class="text-lg font-bold text-slate-900 dark:text-slate-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-300">
              {locale === 'es' ? spanishListing(post).title : post.data.title}
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-300 line-clamp-2">
              {locale === 'es' ? spanishListing(post).description : post.data.description}
            </p>
            <div class="mt-3 text-xs text-slate-500 dark:text-slate-400">
              <FormattedDate date={post.data.pubDate} />
            </div>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}
