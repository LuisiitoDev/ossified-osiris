---
const today = new Date();
---

<footer class="mt-20 py-10 px-6 border-t border-slate-200/50 dark:border-slate-800/50 transition-colors duration-300">
	<div class="mx-auto max-w-6xl flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
		<div class="text-sm text-slate-500 dark:text-slate-400">
			&copy; {today.getFullYear()} <span class="font-semibold text-slate-800 dark:text-slate-200">@LuisiitoDev</span>. All rights reserved.
		</div>
		
		<div class="social-links flex items-center justify-center gap-3">
			<!-- LinkedIn -->
			<a href="https://www.linkedin.com/in/luisiitodev/" target="_blank" rel="noopener noreferrer" class="social-footer-btn" aria-label="Let's connect on LinkedIn">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
					<path d="M22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0zM7.12 20.45H3.56V9h3.56v11.45zM5.34 7.58c-1.14 0-2.06-.92-2.06-2.06 0-1.14.92-2.06 2.06-2.06 1.14 0 2.06.92 2.06 2.06 0 1.14-.92 2.06-2.06 2.06zM20.45 20.45h-3.56v-5.59c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.69h-3.56V9h3.42v1.56h.05c.48-.91 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29z"/>
				</svg>
			</a>
			<!-- X/Twitter -->
			<a href="https://x.com/luisiitodev" target="_blank" rel="noopener noreferrer" class="social-footer-btn" aria-label="Follow me on X">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
			</a>
			<!-- GitHub -->
			<a href="https://github.com/LuisiitoDev" target="_blank" rel="noopener noreferrer" class="social-footer-btn" aria-label="Follow me on GitHub">
				<svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	footer {
		background: rgba(255, 255, 255, 0.4);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}
	
	html.dark footer {
		background: rgba(15, 23, 42, 0.4);
	}

	.social-footer-btn {
		color: rgb(var(--gray));
		background: rgba(var(--gray), 0.05);
		padding: 0.6rem;
		border-radius: 50%;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.social-footer-btn:hover {
		color: rgb(var(--accent));
		background: rgba(var(--accent), 0.1);
		transform: translateY(-3px) scale(1.05);
		box-shadow: 0 4px 12px rgba(var(--accent), 0.15);
	}
</style>
