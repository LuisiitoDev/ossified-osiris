---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import VisitorCounter from '../components/VisitorCounter.astro';
import { responsiveImageAttributes } from '../utils/imageCdn.mjs';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Separate the featured post (latest post) from the rest
const featuredPost = posts[0];
const remainingPosts = posts.slice(1);
const topics = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b));
const formatTopic = (tag: string) => tag.replace(/-/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="transition-colors duration-300">
		<Header />
		
		<main id="main-content" tabindex="-1" class="max-w-6xl px-4 py-8 sm:py-16 mx-auto">
			<!-- Hero Section with Apple Liquid Glass Effect -->
			<section class="hero-section relative overflow-hidden rounded-3xl p-6 sm:p-12 md:p-16 mb-12 sm:mb-16 border border-slate-200/50 dark:border-slate-800/50 shadow-xl bg-white/50 dark:bg-slate-950/25 text-center backdrop-blur-md">
				<div class="relative z-10">
					<h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight mb-4 text-slate-900 dark:text-slate-50 leading-tight">
						Hi, I'm <span class="bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 bg-clip-text text-transparent font-extrabold">@LuisiitoDev</span>
					</h1>
					<p class="text-base sm:text-lg md:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed px-4">
						Welcome to my digital garden! I'm a software developer from Costa Rica sharing thoughts on .NET, Azure, cloud architecture, and self-taught engineering.
					</p>
					<div class="mt-8 flex flex-wrap justify-center gap-3.5">
						<a href="/about" class="px-6 py-2.5 rounded-full bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white font-medium text-sm transition-all duration-200 shadow-md shadow-indigo-600/20 hover:-translate-y-0.5">
							About Me
						</a>
						<a href="#posts-grid" class="px-6 py-2.5 rounded-full bg-white/80 hover:bg-white dark:bg-slate-900/80 dark:hover:bg-slate-900 text-slate-700 dark:text-slate-300 font-medium text-sm transition-all duration-200 border border-slate-200/50 dark:border-slate-800/80 shadow-sm">
							Read Articles
						</a>
					</div>
				</div>
			</section>

			<!-- Compact, keyboard-accessible topic dropdown with crawlable links. -->
			{topics.length > 0 && (
				<div class="relative z-30 mb-8 flex w-full flex-col items-stretch gap-3 sm:flex-row sm:items-start">
					<div class="relative w-full shrink-0 sm:w-72">
					<details class="topic-dropdown relative">
						<summary class="flex w-full cursor-pointer list-none items-center justify-between gap-3 rounded-xl border border-slate-300 bg-white/70 px-4 py-3 text-sm font-semibold text-slate-800 shadow-sm transition-colors hover:border-indigo-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:border-slate-700 dark:bg-slate-900/80 dark:text-slate-100 dark:hover:border-indigo-400">
							<span>Browse topics</span>
							<svg aria-hidden="true" class="topic-chevron h-4 w-4 shrink-0 text-indigo-500 transition-transform" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
							</svg>
						</summary>
						<nav aria-label="Article topics" class="absolute left-0 right-0 top-full z-40 mt-2 max-h-72 overflow-y-auto rounded-xl border border-slate-200 bg-white p-2 shadow-xl dark:border-slate-700 dark:bg-slate-900">
							<a href="#posts-grid" class="block rounded-lg px-3 py-2 text-sm font-semibold text-indigo-600 hover:bg-indigo-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-indigo-500 dark:text-indigo-300 dark:hover:bg-slate-800">All articles</a>
							{topics.map((topic) => (
								<a href={`/topics/${encodeURIComponent(topic)}/`} class="block rounded-lg px-3 py-2 text-sm capitalize text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-indigo-500 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-indigo-300">{formatTopic(topic)}</a>
							))}
						</nav>
					</details>
					</div>
					<form action="/search/" method="get" role="search" class="flex w-full items-center gap-2 sm:max-w-lg">
						<label for="home-search-query" class="sr-only">Search blog articles</label>
						<input id="home-search-query" type="search" name="q" maxlength="120" placeholder="Search articles..." class="min-w-0 flex-1 rounded-xl border border-slate-300 bg-white/70 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:border-slate-700 dark:bg-slate-900/80 dark:text-slate-100" />
						<button type="submit" class="rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500">Search</button>
					</form>
				</div>
			)}
			<!-- Blog Section -->
			<section id="posts-grid" class="scroll-mt-24">
				<h2 class="text-2xl font-bold tracking-tight mb-8 text-slate-900 dark:text-slate-50 flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 text-indigo-500">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18V6a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 6v3.75m-18 0A2.25 2.25 0 005.25 12h13.5a2.25 2.25 0 002.25-2.25V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v3.75m0 0V18" />
					</svg>
					Latest Publications
				</h2>

				<!-- Featured Post -->
				{featuredPost && (
					<div class="mb-12">
						<a href={`/${featuredPost.id}/`} class="group block">
							<div class="glass-card rounded-2xl overflow-hidden grid grid-cols-1 lg:grid-cols-12 gap-0 border border-slate-200/50 dark:border-slate-800/50 hover:border-indigo-500/30 dark:hover:border-indigo-400/20">
								<div class="lg:col-span-7 overflow-hidden h-[240px] sm:h-[360px] lg:h-[400px]">
									<img 
										{...responsiveImageAttributes(featuredPost.data.heroImage, { widths: [480, 960, 1440], sizes: "(max-width: 1024px) 100vw, 60vw" })} loading="eager" decoding="async" fetchpriority="high" width="1200" height="630" 
										alt={featuredPost.data.title}
										class="w-full h-full object-cover group-hover:scale-[1.01] transition-transform duration-500 ease-out"
									/>
								</div>
								<div class="lg:col-span-5 p-6 sm:p-10 flex flex-col justify-between">
									<div>
										<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 mb-4 border border-indigo-500/20">
											FEATURED POST
										</span>
										<h3 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-slate-50 group-hover:text-indigo-500 dark:group-hover:text-indigo-400 transition-colors mb-3 leading-snug">
											{featuredPost.data.title}
										</h3>
										<p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 line-clamp-3 mb-4 leading-relaxed">
											{featuredPost.data.description}
										</p>
									</div>
									<div class="flex items-center justify-between mt-6 pt-6 border-t border-slate-100 dark:border-slate-800/60 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
										<FormattedDate date={featuredPost.data.pubDate} />
										<VisitorCounter slug={`/${featuredPost.id}/`} increment={false} />
									</div>
								</div>
							</div>
						</a>
					</div>
				)}

				<!-- Remaining Posts Grid -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					{remainingPosts.map((post) => (
						<a href={`/${post.id}/`} class="group block">
							<div class="glass-card rounded-2xl overflow-hidden h-full flex flex-col justify-between border border-slate-200/50 dark:border-slate-800/50 hover:border-indigo-500/30 dark:hover:border-indigo-400/20">
								<div>
									<div class="overflow-hidden h-[200px] sm:h-[240px]">
										<img 
											{...responsiveImageAttributes(post.data.heroImage, { widths: [400, 800, 1200], sizes: "(max-width: 768px) 100vw, 50vw" })} loading="lazy" decoding="async" width="800" height="450" 
											alt={post.data.title}
											class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500 ease-out"
										/>
									</div>
									<div class="p-6">
										<h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-50 group-hover:text-indigo-500 dark:group-hover:text-indigo-400 transition-colors mb-2 line-clamp-2 leading-snug">
											{post.data.title}
										</h3>
										<p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
											{post.data.description}
										</p>
									</div>
								</div>
								<div class="p-6 pt-0">
									<div class="flex items-center justify-between pt-4 border-t border-slate-100 dark:border-slate-800/60 text-xs text-slate-500 dark:text-slate-400">
										<FormattedDate date={post.data.pubDate} />
										<VisitorCounter slug={`/${post.id}/`} increment={false} />
									</div>
								</div>
							</div>
						</a>
					))}
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* Scoped local layout styles for landing pages */
	.hero-section {
		position: relative;
	}
	
	/* Hide the browser marker; the chevron indicates disclosure state. */
	.topic-dropdown summary::-webkit-details-marker {
		display: none;
	}
	.topic-dropdown[open] .topic-chevron {
		transform: rotate(180deg);
	}
	.topic-dropdown[open] > summary {
		border-color: rgb(var(--accent));
	}

	/* Smooth scrolling anchor */
	html {
		scroll-behavior: smooth;
	}
</style>
