---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

// Publish only real Spanish translations; never duplicate English article bodies
// under a Spanish URL.
export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => post.id.startsWith('es/'));
  return posts.map((post) => ({
    params: { slug: post.id.slice(3) },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content, headings } = await render(post);
---

<BlogPost {...post.data} lang="es" postId={post.id.slice(3)} headings={headings}>
  <Content />
</BlogPost>
