---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SocialShare from '../components/SocialShare.astro';
import VisitorCounter from '../components/VisitorCounter.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { responsiveImageAttributes } from '../utils/imageCdn.mjs';

type Props = CollectionEntry<'blog'>['data'] & { isArticle?: boolean; postId?: string; headings?: { depth: number; slug: string; text: string }[] };

const { title, description, pubDate, updatedDate, heroImage, isArticle = true, postId, tags = [], headings = [] } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const isBadgeHero = heroImage === '/img/GitHubActions/actions.png';
const isGitHubActionsHero = heroImage === '/img/GitHubActions/hero.svg';
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} pubDate={pubDate} updatedDate={updatedDate} isArticle={isArticle} />
	</head>

	<body class="transition-colors duration-300">
		<Header />
		<main class="max-w-4xl px-4 py-8 sm:py-12 mx-auto">
			<article class="w-full">
				<a href="#article-content" class="sr-only focus:not-sr-only focus:inline-block focus:p-2 focus:bg-indigo-100 focus:text-indigo-900">Skip to article content</a>
				{heroImage && (
					<div class:list={[
						'hero-image-wrapper mb-8 sm:mb-12 overflow-hidden rounded-2xl shadow-xl dark:shadow-2xl/40',
						{ 'flex justify-center bg-slate-50 dark:bg-slate-900/40': isBadgeHero },
						{ 'bg-slate-950': isGitHubActionsHero },
					]}>
						{isBadgeHero ? (
							<img
								width={302}
								height={299}
								{...responsiveImageAttributes(heroImage, { widths: [320, 640], sizes: "320px" })}
								alt={title}
								class="h-auto max-w-[302px] object-contain hover:scale-[1.01] transition-transform duration-500 ease-out"
							/>
						) : isGitHubActionsHero ? (
							<div class="github-actions-hero">
								<img
									width={1600}
									height={520}
									{...responsiveImageAttributes(heroImage, { widths: [960, 1600], sizes: "100vw" })}
									alt={title}
									class="github-actions-hero-background w-full h-auto object-contain"
								/>
								<img
									width={302}
									height={299}
									src="/img/GitHubActions/actions.png"
									alt="GitHub Actions certification badge"
									class="github-actions-badge"
								/>
							</div>
						) : (
							<img
								width={960}
								height={480}
								{...responsiveImageAttributes(heroImage, { widths: [480, 960, 1440], sizes: "(max-width: 640px) 100vw, 960px" })}
								alt={title}
								loading="eager" decoding="async" fetchpriority="high"
								class="w-full h-[240px] sm:h-[400px] object-cover hover:scale-[1.01] transition-transform duration-500 ease-out"
							/>
						)}
					</div>
				)}
				
				<div class="prose-card glass-card rounded-2xl px-6 py-8 sm:p-12">
					<div class="text-center mb-8 pb-8 border-b border-slate-200/50 dark:border-slate-800/50">
						<div class="flex flex-wrap items-center justify-center gap-3 text-sm text-slate-500 dark:text-slate-400 mb-4">
							<div class="inline-flex items-center gap-1">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 opacity-80">
									<path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zm6.75-4.5h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V15zm0 2.25h.008v.008h-.008v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z" />
								</svg>
								<FormattedDate date={pubDate} />
							</div>
							
							{updatedDate && (
								<div class="italic text-xs bg-indigo-50 dark:bg-indigo-950/30 text-indigo-600 dark:text-indigo-400 py-0.5 px-2 rounded-full border border-indigo-100/30 dark:border-indigo-900/20">
									Last updated: <FormattedDate date={updatedDate} />
								</div>
							)}
							
							<span class="hidden sm:inline opacity-30 text-slate-400 dark:text-slate-600">&bull;</span>
							
							<VisitorCounter slug={canonicalURL.pathname} increment={true} />
						</div>
						
						<h1 id="article-title" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-50 bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-900 dark:from-slate-50 dark:via-slate-100 dark:to-indigo-200 bg-clip-text text-transparent mb-2">
							{title}
						</h1>
						{isArticle && tags.length > 0 && (
							<nav aria-label="Article topics" class="mt-4 flex flex-wrap justify-center gap-2">
								{tags.map((tag) => (
									<a class="text-xs rounded-full border border-indigo-500/30 px-3 py-1 text-indigo-600 dark:text-indigo-300 hover:border-indigo-500" href={`/topics/${encodeURIComponent(tag)}/`}>
										{tag.replace(/-/g, " ")}
									</a>
								))}
							</nav>
						)}
					</div>

					{isArticle && <TableOfContents headings={headings} />}

					<div id="article-content" class="prose dark:prose-invert max-w-none text-slate-700 dark:text-slate-300">
						<slot />
					</div>

					{isArticle && headings.length >= 3 && (
						<div class="text-right mt-8">
							<a href="#article-title" class="text-sm font-semibold text-indigo-600 dark:text-indigo-300 hover:underline">Back to top ↑</a>
						</div>
					)}
					<SocialShare title={title} url={canonicalURL.toString()} />
				</div>
				{isArticle && postId && <RelatedPosts currentId={postId} tags={tags} />}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Custom styles specifically for layout wrapper */
	.hero-image-wrapper img {
		box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.15);
	}

	.github-actions-hero {
		position: relative;
		line-height: 0;
	}

	.github-actions-hero-background {
		box-shadow: none !important;
	}

	.github-actions-badge {
		position: absolute;
		left: 4%;
		top: 18%;
		width: 22%;
		height: auto;
		filter: drop-shadow(0 12px 12px rgba(0, 0, 0, 0.45));
		transition: transform 0.5s ease-out;
	}

	.github-actions-hero:hover .github-actions-badge {
		transform: scale(1.02) rotate(-1deg);
	}
	
	html.dark .hero-image-wrapper img {
		box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
	}
	
	.prose-card {
		/* Inherits .glass-card, overrides padding locally if needed */
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.prose-card:hover {
		/* Prevent aggressive hover lift on the entire article reader page, keep it subtle */
		transform: translateY(-2px);
	}

	/* Label/value resource lists rendered from blog post markdown (e.g. Resources section) */
	:global(.resource-list) {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 1.25rem 0;
	}

	:global(.resource-list > div) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		align-items: baseline;
	}

	:global(.resource-list dt) {
		font-weight: 700;
		color: rgb(var(--gray-dark));
		min-width: 7rem;
	}

	:global(.resource-list dd) {
		margin: 0;
	}
</style>
